# RIMS API — environment template (copy to .env and fill values)
PORT=3001
NODE_ENV=development

# Postgres (wajib — tidak ada fallback default)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rims

# Redis (wajib — tidak ada fallback default)
REDIS_URL=redis://127.0.0.1:6379

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
COOKIE_DOMAIN=

# CORS — allow only your web origin
WEB_ORIGIN=http://localhost:5173

# Set "true" HANYA jika API di belakang reverse proxy terpercaya yang menyetel
# X-Forwarded-For (mis. Apache vhost produksi — lihat api/DEPLOYMENT.md). Jika API
# reachable langsung, biarkan "false" agar rate limit tidak bisa di-bypass lewat
# header palsu. Tanpa proxy terpercaya, semua klien berbagi 1 bucket rate limiter.
TRUST_PROXY=false

# Token akses untuk endpoint peta gudang public (read-only). Kosong = endpoint dinonaktifkan.
PUBLIC_MAP_TOKEN=
