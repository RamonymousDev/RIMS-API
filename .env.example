# RIMS API — environment template (copy to .env and fill values)
PORT=3001
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rims

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
COOKIE_DOMAIN=

# CORS — allow only your web origin
WEB_ORIGIN=http://localhost:5173
